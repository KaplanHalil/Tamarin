/*
Client Server Example Solution
====================

We model the following simple protocol:

C -> S: {k}pk(S)
extended with the key confirmation step:
S -> C: h(k)

*/

theory ClientServerExampleSolution
begin

builtins: asymmetric-encryption, hashing

// Registering a public key
rule Register_pk:
    [ Fr(~ltk) ]
  -->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

// Corruption. Uncomment for question 4
rule Reveal_ltk:
    [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
    [ Out(ltk) ]


// Start a new thread executing the client role, choosing the server
// non-deterministically.
rule Client_Init:
    [ Fr(~id)        // fresh session identifier
    , !Pk($S, pkS)   // lookup public-key of server
    ]
  --[ Create_C($C, ~id) ]->
    [ St_C_1($C, ~id, $S, pkS) // Store server and key for next step of thread
    ]

// Client sends first message: C -> S: {k}pk(S)
rule Client_1:
  let m = aenc(~k, pkS)
  in
    [ Fr(~k)                   // choose fresh key
    , St_C_1($C, ~id, $S, pkS) // Lookup state (server and key) from previous step
    ]
  --[ Send($C, m)
    , End_C($C, $S, pkS, ~k)
    , Claim_Secret($C, $S, ~k) ]-> // claim secrecy for the session key 'k'
    [
      St_C_2($C, ~id, $S, pkS, ~k) // Store state and add fresh session key 'k' 
    , Out(m)                   // Send the encrypted session key to the server
    ]

rule Client_2:
  let m = h(~k)
  in
    [ St_C_2($C, ~id, $S, pkS, ~k) // Store state and add fresh session key 'k' 
    , In(m) ] // receive hashed key for confirmation
  --[ Claim_Confirmation($C, $S, ~k) ]-> // claim key confirmation for session key 'k'
    [ ]

// Start a server thread
rule Serv_Init:
    [ Fr(~id)           // fresh session identifier
    , !Ltk($S, ~ltkS)   // lookup the private-key
    ]
  --[ Create_S($S, ~id) ]->
    [ St_S_1($S, ~id, ~ltkS) ]  // store state for next step

// Server receiving a session-key from some client.
rule Serv_1:
  let m = aenc(k, pk(~ltkS))
  in
    [ St_S_1($S, ~id, ~ltkS)               // lookup the current state
    , In(m)                               // receive a message
    ]
  --[ Receive($S, m)
    , End_S($C, $S, pk(~ltkS), k)
    , Claim_SecretS($S, k)  // claim secrecy for the session key 'k'
    ]->
    [ St_S_2($S, ~id, ~ltkS, k) ] // store state, including session key

// Server confirming receipt of a session-key k from some client by sending h(k)
rule Serv_2:
  let m = h(k)
  in
    [ St_S_2($S, ~id, ~ltkS, k) ] // lookup current state
  --[ Claim_Confirmed($S, k) // claim that confirmation has been sent out
    ]->
    [ Out(m) ]  // send key-confirmation response

lemma Client_session_key_secrecy:
  " All C S k #i.
    (
      /* If client 'C' has set up a session key 'k' with a server 'S' */
      Claim_Secret(C, S, k) @ #i
      /* and neither of the two communicating parties are compromised */
   & not (Ex #j. LtkReveal(C) @ #j) & not (Ex #j. LtkReveal(S) @ #j)
        /* the adversary cannot know 'k' */
        ==> not(Ex #j. K(k) @ #j)
    )
  "

lemma Server_session_key_secrecy:
  " All S k #i.
    (
      /* If server 'S' has set up a session key 'k'  */
      Claim_SecretS(S, k) @ #i
      /* and the server is not compromised (note we do not even know who the sender is!) */
   & not (Ex #j. LtkReveal(S) @ #j)
        /* the adversary cannot know 'k' */
        ==> not(Ex #j. K(k) @ #j)
    )
  "

lemma Client_key_confirmation:
  " All C S k #i.
    (
      /* if client 'C' has received key confirmation on key 'k' */
      Claim_Confirmation(C, S, k) @#i
      /* and neither of the two communicating parties are compromised */
   & not (Ex #j. LtkReveal(C) @ #j) & not (Ex #j. LtkReveal(S) @ #j)
        /* the server 'S' has sent confirmation on key 'k' */
        ==> Ex #j. Claim_Confirmed(S, k) @#j
     )
  "

lemma Client_Server_can_finish:
  exists-trace
  " Ex C S pkS k #i #j.
        End_C(C, S, pkS, k) @ #i & End_S(C, S, pkS, k) @ #j
      /* and neither of the two communicating parties are compromised */
   & not (Ex #j. LtkReveal(C) @ #j) & not (Ex #j. LtkReveal(S) @ #j)
  "

end
