theory toy0

begin

builtins: symmetric-encryption , diffie-hellman

functions: genpriv/1 [private]

rule revpsk:

    let
        psk = genpriv('psk')
    in
[]
-->
[Out(psk)]


rule A0:

    let
        psk = genpriv('psk')
        sifreliGiz = senc(~giz, psk)
        eph_a_acik = 'g'^ eph_a_giz
    in

[Fr(~giz),
Fr(eph_a_giz)
]
-->
[Out(<sifreliGiz, eph_a_acik>)]

rule B0:

    let 
        sifreliGiz = fst(a0cikti)
        eph_a_acik = snd(a0cikti)
        psk = genpriv('psk')
        Giz = senc(sifreliGiz, psk)
        ss = eph_a_acik ^ eph_b_giz
    in
[In(a0cikti), Fr(eph_b_giz)]
--[Bknowsgiz(Giz)]->
[]

lemma secrecy:
  "All Giz #i. Bknowsgiz(Giz)@i ==> not (Ex #j. K(Giz)@j)"



end

