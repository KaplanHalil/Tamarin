theory toy0
/*
A                   B
 




*/
begin

builtins: symmetric-encryption , hashing

rule shared_key:

[Fr(~psk)]
-->
[!SharedKey(~psk)]

rule A0:

    let
        sifreli_RNa= senc(~RNa,~psk)
    in

[!SharedKey(~psk),Fr(~RNa)]
-->
[StateA(~psk,~RNa), Out(sifreli_RNa)]

rule B0:

    let
        sifreli_RNB= senc(~RNb,~psk)
        RNA=sdec(sifreli_RNA,~psk)
        ss_b=h(<RNA,~RNb>)
        sifreliSS_b = senc(ss_b,~psk)
    in

[!SharedKey(~psk),Fr(~RNb), In(sifreli_RNA)]
-->
[StateB(~psk,~RNb,ss_b), Out(<sifreli_RNB, sifreliSS_b>)]

rule A1:

    let
        RNB = sdec(sifreli_RNB,~psk)
        ss_b= sdec(sifreliSS_b)
        ss_a=h(<~RNa,RNB>)
        sifreliSS_a = senc(ss_a,~psk)
    in

[In(<sifreli_RNB, sifreliSS_b>),StateA(~psk,~RNa)]
--[_restict()]->
[]
end

