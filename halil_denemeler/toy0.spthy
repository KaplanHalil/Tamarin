theory toy0

begin

builtins: symmetric-encryption 

functions: genpriv/1 [private]

rule revpsk:

    let
        psk = genpriv('psk')
    in
[]
-->
[Out(psk)]


rule A0:

    let
        psk = genpriv('psk')
        sifreliGiz = senc(~giz, psk)
    in

[Fr(~giz)]
-->
[Out(sifreliGiz)]

rule B0:

    let 
        psk = genpriv('psk')
        Giz = senc(sifreliGiz, psk)
    in
[In(sifreliGiz)]
--[Bknowsgiz(Giz)]->
[]

lemma secrecy:
  "All Giz #i. Bknowsgiz(Giz)@i ==> not (Ex #j. K(Giz)@j)"



end

