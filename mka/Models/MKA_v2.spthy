theory Simplified_MKA_halil

/* 

*****Simplified Model of the MKA Protocol*****   
KeyServer                                      Server
    |                                             |
    |                                             |
    |------- KEK = ATF(CAK,"KEK") --------------- |
    |------- ICK = ATF(CAK,"ICK") --------------- |
    |                                             |
    |                                             |
    |SAK = ATF(CAK,"SAK")                         |
    |C = Enc(SAK,KEK)                             |
    |T = MAC(C,ICK)                               |
    |                                             |
    |-------------- (C,T) ----------------------> |
    |                                             |
    |                                    Verify(T)|
    |                               SAK=Dec(KEK,C)|
    |                                             |
    |============= Shared SAK =================== |

*/
begin

builtins: symmetric-encryption, hashing

functions:
  atf/2,
  mac/2,
  macverify/3,
  genpriv/1 [private],
  mactrue/0, 
  genid/1 [private]
  

equations:
  macverify(mac(M,K),M,K) = mactrue


rule KeyServer:
  let 
      CAK = genpriv('CAK')
      KEK = atf(CAK,'KEK')
      ICK = atf(CAK,'ICK')
      SAK = atf(CAK,'SAK')
      C = senc(SAK,KEK)
      T = mac(C,ICK)

  in 
  []--[SentSAK($Keyserver,SAK), SecretSAK(SAK)]->[Out(<C,T>)]

rule Server:
  
  let 
      CAK = genpriv('CAK')
      KEK = atf(CAK,'KEK')
      ICK = atf(CAK,'ICK')
      SAK = sdec(C,KEK)
  in
  [In(<C,T>)]
  --[
    _restrict(macverify(T,C,ICK)=mactrue),
    SessionEstablished($Server,SAK)]->[]


lemma executable:
  exists-trace
  "
    Ex ks sak #i.
      SentSAK(ks,sak)@i
  "

lemma agreement_on_sak:
  "
  All s sak #i.
    SessionEstablished(s,sak)@i
    ==>
    (Ex ks #j.
        SentSAK(ks,sak)@j)
  "

lemma injective_agreement:
"
All s sak #i.
    SessionEstablished(s,sak)@i
    ==>
    (Ex ks #j.
        SentSAK(ks,sak)@j
        &
        (All #k.
            SessionEstablished(s,sak)@k
            ==> #k = #i))
"

lemma authentication:
"
All s sak #i.
    SessionEstablished(s,sak)@i
    ==>
    (Ex ks #j.
        SentSAK(ks,sak)@j
        & #j < #i)
"

lemma sak_secrecy:
"
All sak #i.
    SecretSAK(sak)@i
    ==>
    not(Ex #j. K(sak)@j)
"
//Saldırgan KeyServer olmadan oturum kurduramaz.
lemma no_forgery:
"
All s sak #i.
    SessionEstablished(s,sak)@i
    ==>
    (Ex ks #j.
       SentSAK(ks,sak)@j)
"



end