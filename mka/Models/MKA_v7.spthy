theory MKA_v7
/*
***** Simplified MKA Protocol with Rekey ***** ÇALIŞIYORRRRRRRR

KeyServer                                                  Server
    |                                                         |
    |========== Pre-Shared CAK ==============================>|
    |                                                         |
    | KEK = KDF(CAK, "KEK")                                   |
    | ICK = KDF(CAK, "ICK")                                   |
    | MN   = Fresh()                                          |
    | KS_nonce0 = Fresh()                                     |
    | KN   = Fresh()                                          |
    | SAK1 = KDF(CAK, <$Keyserver, KN, KS_nonce0 >)           |                                         
    | C1   = Enc(SAK1, KEK)                                   |
    | ICV1 = MAC(<$Keyserver, MN_KS, KN, C1>, ICK)            |
    | MKAPDU0_keyserver = <$Keyserver, MN_KS, KN, C1, ICV1>   |
    | KSSTATE0(MN_KS, KN)                                     |
    |--------------------(MKAPDU0_keyserver)----------------->|
    |                                                         |
    |                                    ICK = KDF(CAK, "ICK")|
    |                                    KEK = KDF(CAK, "KEK")|
    |                                restrict(ICV1 mac verify)|
    |                                           SAK1 = Dec(C1)|
    |                      ICV2 = MAC(<$Server, MN1, KN>, ICK)|
    |                                           MN_S = Fresh()|
    |               MKAPDU0_server = <$Server, MN_S, KN, ICV2>|
    |                            SState(MN_KS, MN_S, KN, SAK1)|
    |							                              |              
    |<--------------------(MKAPDU0_server)--------------------|
    | In(KSSTATE0(MN_KS, KN))                                 |
    | restrict(MN1 = Count(MN))                               |
    | restrict(ICV2 MAC verify)                               |
    | KSTATE1(MN_KS, KN, MN_S)                                |
    |                                                         |
    |============= Shared Fresh SAK1 =========================|
    |                                                         |
    |------------ Periodic Rekey Trigger ---------------------|
    | In(KSSTATE1(MN_KS, KN, MN_S))                           |
    | KEK = KDF(CAK, "KEK")                                   |
    | ICK = KDF(CAK, "ICK")                                   |
    | MN_KS1  = Count(MN_KS)                                  |
    | KS_nonce1 = Fresh()                                     |
    | KN1  = Count(KN)                                        |
    | SAK2 = KDF(CAK, <$Keyserver, KN1, KS_nonce1>)           |
    | C2   = Enc(SAK2, KEK)                                   |
    | ICV3 = MAC(<$Keyserver, MN_KS1, KN1, C2>, ICK)          |
    | MKAPDU1_keyserver = <$Keyserver, MN_KS1, KN1, C2, ICV3> |
    | KSTATE2(MN_KS, KN, MN_S, KN1)                           |    
    |--------------------(MKAPDU1_keyserver)----------------->|
    |                        In(SState(MN_KS, MN_S, KN, SAK1))|
    |                                    ICK = KDF(CAK, "ICK")|
    |                                    KEK = KDF(CAK, "KEK")|
    |                                restrict(ICV3 mac verify)|
    |                          restrict(MN_KS1 = count(MN_KS))|
    |                                restrict(KN1 = count(KN))|
    |                                           SAK2 = Dec(C2)|
    |                                      MN_S2 = Count(MN_S)|
    |                   ICV4 = MAC(<$Server, MN_S2, KN1>, ICK)|
    |             MKAPDU1_server = <$Server, MN_S2, KN1, ICV4>|
    |                                                         |
    |<--------------------(MKAPDU1_server)--------------------|
    | In(KSSTATE2(MN_KS, KN, MN_S, KN1))                      |
    | restrict(MN_S2 = Count(MN_S))                           |
    | restrict(KN1 = KN1(In state))                           |
    |                                                         |
    |============= Shared Fresh SAK2 =========================|
    |                                                         |
    |============= DONE ======================================|
*/
begin

builtins: symmetric-encryption

functions:
  kdf/2,
  count/1,
  mac/2,
  macverify/3,
  mactrue/0

equations:
  macverify(mac(M,K),M,K) = mactrue

// Paylaşılan CAK'ı sisteme yükler ve uzun vadeli bir gerçek olarak depolar.
rule Setup_CAK:
  [ Fr(~cak) ]
  --[ CAKSetup(~cak) ]->
  [ !SharedCAK(~cak) ]

// SAK'ın saldırgan tarafından açığa çıkması için kullanılan ödün kuralı.
rule Reveal_SAK:
  [ KSSTATE0(mn,kn,sak) ]
  --[ RevealSAK(mn,kn,sak) ]->
  [ Out(sak) ]

// CAK'ın saldırgan tarafından açığa çıkması için kullanılan ödün kuralı.
rule Reveal_CAK:
  [ !SharedCAK(~cak) ]
  --[ RevealCAK(~cak) ]->
  [ Out(~cak) ]

// KeyServer, ilk oturum için SAK'ı türetir, KEK ile şifreler, ICK ile MAC'lar ve Server'a gönderir.
rule Initial_KeyServer_Send:
  let
    kek = kdf(~cak,'KEK')
    ick = kdf(~cak,'ICK')
    sak1 = kdf(~cak,<~mn,$Keyserver>)
    c1 = senc(sak1,kek)
    icv1 = mac(<$Keyserver, ~mn, ~kn, c1 >, ick)
  in
  [ !SharedCAK(~cak), Fr(~mn), Fr(~kn) ]--[
    SentInitialSAK(count(~mn),~kn,sak1)
  ]->
  [ Out(<$Keyserver,~mn,~kn,c1,icv1>),
    KSSTATE0(~mn,~kn,sak1) ]

// Server, gelen şifreli yükü doğrular, MAC'ı kontrol eder, SAK'ı çözer ve bir onay (ACK) gönderir.
rule Initial_Server_Receive:
  let
    kek = kdf(~cak,'KEK')
    ick = kdf(~cak,'ICK')
    sak1 = sdec(c1,kek)
    mn1 = count(~mn)
    icv2 = mac(<$Server,mn1,~kn>,ick)
  in
  [ In(<$Keyserver,~mn,~kn,c1,icv1>), !SharedCAK(~cak) ]--[
    _restrict(macverify(icv1,<$Keyserver, ~mn, ~kn ,c1>,ick)=mactrue),
    InitialAckPrepared(mn1,~kn)
  ]->
  [ Out(<$Server,mn1,~kn,icv2>),
    SSTATE1(mn1,~kn) ]

// KeyServer, Server'dan gelen onayı alır ve ilk oturumun başarıyla tamamlandığını işaretler.
rule Initial_KeyServer_Confirm:
  let
    ick = kdf(~cak,'ICK')
  in
  [ 
    In(<$Server,mn1,~kn,icv2>),
    !SharedCAK(~cak),
    KSSTATE0(~mn,~kn,sak1) ]--[
    _restrict(mn1 = count(~mn)),
    _restrict(macverify(icv2,<$Server, mn1, ~kn>,ick)=mactrue),
    InitialSessionCompleted(mn1,~kn,sak1)
  ]->
  [ 
    KSSTATE1(mn1,~kn) ]

// KeyServer, ilk oturum tamamlandıktan sonra yeni bir SAK ile rekey işlemini başlatır.
rule Rekey_KeyServer_Send:
  let
    kek = kdf(~cak,'KEK')
    ick = kdf(~cak,'ICK')
    mn2 = count(mn1)
    kn1 = count(~kn)
    sak2 = kdf(~cak,< mn2, $Keyserver>)
    c2 = senc(sak2,kek)
    icv3 = mac(<$Keyserver,mn2,kn1,c2>,ick)
  in
  [ !SharedCAK(~cak), KSSTATE1(mn1,~kn) ]--[
    SentRekeySAK(mn2,kn1,sak2),
    RekeyStarted(mn2,kn1)
  ]->
  [ Out(<$Keyserver,mn2,kn1,c2,icv3>),
    
    KSSTATE2(mn2,kn1) ]

// Server, rekey SAK'ını alır, doğrular, çözer ve bir onay gönderir.
rule Rekey_Server_Receive:
  let
    kek = kdf(~cak,'KEK')
    ick = kdf(~cak,'ICK')
    sak2 = sdec(c2,kek)
    mn3 = count(mn2)
    icv4 = mac(<$Server,mn3,kn1>,ick)
  in
  [ In(<$Keyserver,mn2,kn1,c2,icv3>), !SharedCAK(~cak), SSTATE1(mn1,~kn) ]--[
    _restrict(mn2 = count(mn1)),
    _restrict(macverify(icv3,<$Keyserver, mn2, kn1, c2>,ick)=mactrue),
    RekeyAckPrepared(mn2,kn1)
  ]->
  [ Out(<$Server,mn3,kn1,icv4>),
    SSTATE2(mn3,kn1) ]

// KeyServer, Server'dan rekey onayını alır ve rekey oturumunun başarıyla tamamlandığını işaretler.
rule Rekey_KeyServer_Confirm:
  let
    
    ick = kdf(~cak,'ICK')
    mn3 = count(mn2)
    sak2 = kdf(~cak,<mn2,$Keyserver>)
  in
  [ 
    In(<$Server,mn3,kn1,icv4>),
    !SharedCAK(~cak),
    KSSTATE2(mn2,kn1) ]--[
    _restrict(mn3 = count(mn2)),
    _restrict(macverify(icv4,<$Server, mn3, kn1>,ick)=mactrue),
    RekeySessionCompleted(mn2,kn1,sak2)
  ]->
  [ ]

lemma executable:
  exists-trace
  "
    Ex mn1 kn sak1 mn3 kn1 sak2 #i #j.
      InitialSessionCompleted(mn1,kn,sak1)@i
      & RekeySessionCompleted(mn3,kn1,sak2)@j
  "

lemma initial_agreement:
  "
  All mn kn sak #i.
    InitialSessionCompleted(mn,kn,sak)@i
    ==> (Ex #j. SentInitialSAK(mn,kn,sak)@j & #j < #i)
  "

lemma rekey_agreement:
  "
  All mn kn sak #i.
    RekeySessionCompleted(mn,kn,sak)@i
    ==> (Ex #j. RekeyStarted(mn,kn)@j & #j < #i)
  "

lemma initial_key_confirmation:
  "
  All mn kn sak #i.
    InitialSessionCompleted(mn,kn,sak)@i
    & (Ex cak #j. CAKSetup(cak)@j & #j < #i)
    & not(Ex cak #k. RevealCAK(cak)@k)
    ==> (Ex #l. InitialAckPrepared(mn,kn)@l & #l < #i)
  "

lemma rekey_key_confirmation:
  "
  All mn kn sak #i.
    RekeySessionCompleted(mn,kn,sak)@i
    & (Ex cak #j. CAKSetup(cak)@j & #j < #i)
    & not(Ex cak #k. RevealCAK(cak)@k)
    ==> (Ex #l. RekeyAckPrepared(mn,kn)@l & #l < #i)
  "

lemma initial_sak_secrecy_no_reveal:
  "
  All mn kn sak #i.
    InitialSessionCompleted(mn,kn,sak)@i
    & (Ex cak #j. CAKSetup(cak)@j & #j < #i)
    & not(Ex #k. RevealSAK(mn,kn,sak)@k)
    & not(Ex cak #l. RevealCAK(cak)@l)
    ==> not(Ex #m. K(sak)@m)
  "

lemma rekey_sak_secrecy_no_reveal:
  "
  All mn kn sak #i.
    RekeySessionCompleted(mn,kn,sak)@i
    & (Ex cak #j. CAKSetup(cak)@j & #j < #i)
    & not(Ex #k. RevealSAK(mn,kn,sak)@k)
    & not(Ex cak #l. RevealCAK(cak)@l)
    ==> not(Ex #m. K(sak)@m)
  "

lemma cak_secrecy_no_reveal:
  "
  All cak #i.
    CAKSetup(cak)@i
    & not(Ex #j. RevealCAK(cak)@j)
    ==> not(Ex #k. K(cak)@k)
  "

lemma no_replay_initial:
  "
  All mn kn sak #i #j.
    InitialSessionCompleted(mn,kn,sak)@i
    & InitialSessionCompleted(mn,kn,sak)@j
    ==> #i = #j
  "

lemma rekey_replay_protection:
  "
  All mn2 kn1 #i #j.
    RekeyAckPrepared(mn2,kn1)@i
    & RekeyAckPrepared(mn2,kn1)@j
    ==> #i = #j
  "

lemma rekey_message_single_use:
  "
  All mn2 kn1 c2 icv3 #i #j.
    RekeyMessage(mn2,kn1,c2,icv3)@i
    & RekeyMessage(mn2,kn1,c2,icv3)@j
    ==> #i = #j
  "

lemma server_authentication_initial:
  "
  All mn kn sak #i.
    InitialSessionCompleted(mn,kn,sak)@i
    & (Ex cak #j. CAKSetup(cak)@j & #j < #i)
    & not(Ex cak #k. RevealCAK(cak)@k)
    ==> (Ex #l. InitialAckPrepared(mn,kn)@l & #l < #i)
  "

lemma server_authentication_rekey:
  "
  All mn kn sak #i.
    RekeySessionCompleted(mn,kn,sak)@i
    & (Ex cak #j. CAKSetup(cak)@j & #j < #i)
    & not(Ex cak #k. RevealCAK(cak)@k)
    ==> (Ex #l. RekeyAckPrepared(mn,kn)@l & #l < #i)
  "

lemma rekey_after_initial_completion:
  "
  All mn2 kn1 sak2 #i.
    RekeySessionCompleted(mn2,kn1,sak2)@i
    ==> (Ex mn1 kn sak1 #j.
      InitialSessionCompleted(mn1,kn,sak1)@j & #j < #i)
  "

lemma rekey_cannot_start_before_initial_completion:
  "
  All mn2 kn1 #i.
    RekeyStarted(mn2,kn1)@i
    ==> (Ex mn1 kn sak1 #j.
      InitialSessionCompleted(mn1,kn,sak1)@j & #j < #i)
  "

// Test amacıyla kasıtlı olarak yazılmış yanlış lemma; bu her zaman falsified olmalıdır.
lemma test_false_lemma:
  "
  All mn kn sak #i.
    InitialSessionCompleted(mn,kn,sak)@i
    ==> (Ex #j. FalseFact(mn,kn,sak)@j)
  "

end