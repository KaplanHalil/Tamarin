theory SignedDH_simple begin

builtins: diffie-hellman, signing

// Public key infrastructure
rule Register_pk:
  [ Fr(~ltk) ]
    -->
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

// Protocol
rule Init_1:
  [ Fr(~tid), Fr(~ekI), !Ltk($I, ltkI) ]
  -->
  [ Init_1( ~tid, $I, $R, ~ekI )
  , Out( <$I, $R, 'g' ^ ~ekI, sign(<'1', $I, $R,'g'^~ekI>,ltkI) > ) ]

rule Init_2:
  [ Init_1( ~tid, $I, $R, ~ekI )
  , !Pk($R, pkR)
  , In( <$R, $I, Y, m2> )
  ]
--[ _restrict( verify(m2, <'2', $R, $I, Y>, pkR) = true )
  , SessionKey($I,$R, Y^~ekI) ]->
  []

rule Resp:
  [ !Pk($I, pkI)
  , !Ltk($R, ltkR)
  , Fr(~ekR)
  , In( <$I, $R, X, m1> )
  ]
--[ _restrict( verify(m1, <'1', $I, $R, X>, pkI) = true )
  , SessionKey($I,$R, X^~ekR) ]->
  [ Out( <$R, $I, 'g'^~ekR, sign(<'2', $R, $I, 'g'^~ekR >, ltkR)> ) ]

lemma Secrecy:
  "All I R sessKey #i.
    SessionKey(I,R,sessKey)@i
    ==> not (Ex #j. K(sessKey)@j) "

end
